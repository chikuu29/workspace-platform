{
    "appName": "Gym",
    "name": "AddMember",
    "id": "1",
    "owner": "Suryanrayan Biswal",
    "createdAt": "19 Nov 2024",
    "API_INTIGATION_CONFIG": {},
    "scriptFiles": [
        "Gym/addMemberScript"
    ],
    "postScript": "documentPostScript",
    "UI_VIEW": {
        "schema": {
            "config": [
                {
                    "name": "memberName",
                    "text": "Member Name",
                    "description": "Enter the member's name",
                    "type": "text",
                    "disabled": false,
                    "required": true,
                    "maxLength": 20,
                    "minLength": 5,
                    "hidden": false,
                    "widget": "textField",
                    "outLineBorder": true,
                    "listeners": {
                        "change": {
                            "methodName": "onChangeMemberName",
                            "param": "value"
                        }
                    }
                },
                {
                    "name": "memberEmail",
                    "text": "Member Email",
                    "description": "Enter the member's email",
                    "type": "email",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField"
                },
                {
                    "name": "memberPhone",
                    "text": "Member Phone",
                    "description": "Enter the member's phone number",
                    "type": "tel",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField",
                    "required": true
                },
                {
                    "name": "memberDOB",
                    "text": "Date of Birth",
                    "description": "Select the member's date of birth",
                    "type": "date",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField"
                },
                {
                    "name": "memberAddress",
                    "text": "Address",
                    "description": "Enter the member's address",
                    "type": "text",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textAreaField"
                },
                {
                    "name": "memberCity",
                    "text": "City",
                    "description": "Enter the city of residence",
                    "type": "text",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField"
                },
                {
                    "name": "memberState",
                    "text": "State/Province",
                    "description": "Enter the member's state or province",
                    "type": "text",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField"
                },
                {
                    "name": "memberZip",
                    "text": "Postal Code",
                    "description": "Enter the postal code",
                    "type": "text",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField"
                },
                {
                    "name": "memberEmergencyContact",
                    "text": "Emergency Contact Name",
                    "description": "Enter the emergency contact's name",
                    "type": "text",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField"
                },
                {
                    "name": "memberEmergencyPhone",
                    "text": "Emergency Contact Phone",
                    "description": "Enter the emergency contact's phone number",
                    "type": "tel",
                    "disabled": false,
                    "hidden": false,
                    "widget": "textField",
                    "required": true
                },
                {
                    "name": "memberGender",
                    "text": "Gender",
                    "description": "Select the member's gender",
                    "type": "text",
                    "disabled": false,
                    "hidden": false,
                    "widget": "radioField",
                    "options": [
                        {
                            "label": "Male",
                            "value": "male"
                        },
                        {
                            "label": "Female",
                            "value": "female"
                        },
                        {
                            "label": "Other",
                            "value": "other"
                        }
                    ],
                    "defaultValue": ""
                },
                {
                    "name": "memberProfilePicture",
                    "text": "Upload Document",
                    "description": "Upload a document or image for verification",
                    "type": "file",
                    "accept": "image/*",
                    "s3Config":{},
                    "defaultApiConfig":{
                        "uploadURL":"app/upload"
                    },
                    "disabled": false,
                    "hidden": false,
                    "liveCameraAllow":true,
                    "widget": "uploadField",
                    "capture": "environment",
                    "required": true,
                    "multiple": false,
                    "maxFileSize": 5000000
                }
            ]
        }
    },
    "active": true,
    "truncated": false,
    "theme": "default",
    "language": "en",
    "isHtmlSanitizeRequired": false,
    "securityEnabled": true,
    "handlers": [],
    "mobileView": {}
}