{
    "id": "2",
    "pageName": "AddTrainer",
    "route": "AddTrainer",
    "appName": "gym",
    "appMeta": {
        "appName": "Gym",
        "viewName": "AddTrainer",
        "viewId": "2",
        "version": "1.0.0",
        "owner": "Suryanarayan Biswal",
        "createdAt": "2024-11-19"
    },
    "settings": {
        "theme": "default",
        "language": "en",
        "securityEnabled": true,
        "sanitizeHtml": false
    },
    "scripts": {
        "files": [
            "Gym/addTrainerScript"
        ],
        "postScript": "documentPostScript"
    },
    "ACTIONS": {
        "showSaveButton": true,
        "events": {
            "draft": {
                "type": "API_CALL",
                "url": "app/draft",
                "method": "POST",
                "successMessage": "Membership details saved as draft!",
                "errorMessage": "Failed to save draft. Please try again."
            },
            "submit": {
                "type": "API_CALL",
                "url": "gym/addTrainer",
                "method": "POST",
                "successMessage": "Trainer registration successful!",
                "errorMessage": "Registration failed. Please check the details and try again.",
                "laterActions": {
                    "type": "NAVIGATION",
                    "path": "/app/gym/TrainerProfile?trainer_id={{trainer_id}}"
                }
            }
        },
        "ACTION_BUTTONS": [
            {
                "name": "Draft",
                "text": "Draft",
                "iconName": "LuSave",
                "widget": "button",
                "styles": {
                    "variant": "solid",
                    "bg": "gradient_orange"
                },
                "hidden": false,
                "oneLiner": true,
                "mandatory": true,
                "event": "draft"
            }
        ]
    },
    "UI_TYPE": {
        "type": "FORM_VIEW",
        "title": "Trainer Onboarding",
        "description": "Register new trainers with a comprehensive, guided experience.",
        "target": "forms",
        "layoutStyles": {
            "p": 0
        }
    },
    "UI_VIEW": {
        "schema": {
            "forms": {
                "tabs": [
                    {
                        "title": "Personal Details",
                        "description": "Basic identification and contact information.",
                        "iconName": "LuUser",
                        "widgets": [
                            {
                                "name": "firstName",
                                "text": "First Name",
                                "description": "Enter trainer's first name",
                                "widget": "textField",
                                "oneLiner": true,
                                "mandatory": true,
                                "maxLength": 50
                            },
                            {
                                "name": "lastName",
                                "text": "Last Name",
                                "description": "Enter trainer's last name",
                                "widget": "textField",
                                "oneLiner": true,
                                "mandatory": true,
                                "maxLength": 50
                            },
                            {
                                "name": "email",
                                "text": "Email Address",
                                "description": "Official email for internal communications",
                                "type": "email",
                                "widget": "textField",
                                "oneLiner": true,
                                "mandatory": true
                            },
                            {
                                "name": "phone",
                                "text": "Phone Number",
                                "description": "Primary contact number",
                                "type": "tel",
                                "widget": "textField",
                                "oneLiner": true,
                                "mandatory": true
                            },
                            {
                                "name": "gender",
                                "text": "Gender",
                                "description": "Select the trainer's gender",
                                "widget": "radioField",
                                "oneLiner": true,
                                "enableClear": true,
                                "mandatory": true,
                                "options": [
                                    {
                                        "label": "Male",
                                        "value": "male"
                                    },
                                    {
                                        "label": "Female",
                                        "value": "female"
                                    },
                                    {
                                        "label": "Other",
                                        "value": "other"
                                    }
                                ]
                            },
                            {
                                "name": "address",
                                "text": "Residential Address",
                                "description": "Current permanent residence details",
                                "widget": "textAreaField",
                                "oneLiner": true,
                                "mandatory": false
                            }
                        ]
                    },
                    {
                        "title": "Professional Details",
                        "description": "Expertise, experience, and availability.",
                        "iconName": "LuActivity",
                        "widgets": [
                            {
                                "name": "specialization",
                                "text": "Specialization",
                                "description": "Primary area of expertise (e.g., Strength Training, Yoga, Cardio, CrossFit)",
                                "widget": "radioField",
                                "oneLiner": true,
                                "options": [
                                    {
                                        "label": "Strength Training",
                                        "value": "strength"
                                    },
                                    {
                                        "label": "Yoga",
                                        "value": "yoga"
                                    },
                                    {
                                        "label": "Cardio & HIIT",
                                        "value": "cardio"
                                    },
                                    {
                                        "label": "CrossFit",
                                        "value": "crossfit"
                                    },
                                    {
                                        "label": "Personal Training",
                                        "value": "personal"
                                    }
                                ],
                                "mandatory": true
                            },
                            {
                                "name": "experienceYears",
                                "text": "Years of Experience",
                                "description": "Total professional training experience in years",
                                "widget": "textField",
                                "type": "number",
                                "oneLiner": true,
                                "mandatory": true
                            },
                            {
                                "name": "joiningDate",
                                "text": "Joining Date",
                                "description": "Select the official start date of employment",
                                "widget": "dateField",
                                "oneLiner": true,
                                "mandatory": true,
                                "enableClear": true
                            },
                            {
                                "name": "availableSlot",
                                "text": "Available Slot",
                                "description": "Preferred training session slot",
                                "widget": "dateAndTimeField",
                                "oneLiner": true,
                                "mandatory": true,
                                "enableClear": true
                            },
                            {
                                "name": "bio",
                                "text": "Trainer Bio",
                                "description": "A short bio highlighting certifications, achievements, and training philosophy",
                                "widget": "textAreaField",
                                "oneLiner": true
                            }
                        ]
                    },
                    {
                        "title": "Verification",
                        "description": "Documents and profile setup.",
                        "iconName": "LuShieldCheck",
                        "widgets": [
                            {
                                "name": "idProof",
                                "text": "Government ID Proof",
                                "description": "Upload a valid passport, driver's license, or national ID",
                                "widget": "uploadField",
                                "oneLiner": true,
                                "mandatory": false,
                                "liveCameraAllow": true,
                                "defaultApiConfig": {
                                    "uploadURL": "app/upload"
                                }
                            },
                            {
                                "name": "certifications",
                                "text": "Certifications",
                                "description": "Upload professional fitness certifications (e.g., ACE, NASM, ISSA)",
                                "widget": "uploadField",
                                "oneLiner": true,
                                "mandatory": false,
                                "liveCameraAllow": false,
                                "defaultApiConfig": {
                                    "uploadURL": "app/upload"
                                }
                            },
                            {
                                "name": "profilePic",
                                "text": "Profile Photo",
                                "description": "A professional photo for the gym's trainer directory",
                                "widget": "uploadField",
                                "oneLiner": true,
                                "liveCameraAllow": true,
                                "mandatory": true,
                                "accept": "image/*",
                                "defaultApiConfig": {
                                    "max_size_bytes": 5242880,
                                    "accept": "image/*",
                                    "uploadURL": "app/upload"
                                }
                            },
                            {
                                "name": "paymentMode",
                                "text": "Salary Payment Mode",
                                "description": "Preferred method for salary disbursement",
                                "widget": "radioField",
                                "oneLiner": true,
                                "enableClear": true,
                                "options": [
                                    {
                                        "label": "Bank Transfer",
                                        "value": "bank"
                                    },
                                    {
                                        "label": "Cash",
                                        "value": "cash"
                                    },
                                    {
                                        "label": "UPI / Digital",
                                        "value": "upi"
                                    }
                                ],
                                "events": {
                                    "change": [
                                        {
                                            "condition": "value === 'bank'",
                                            "actions": [
                                                {
                                                    "type": "show",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode"
                                                    ]
                                                },
                                                {
                                                    "type": "mandatory",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode"
                                                    ],
                                                    "value": true
                                                },
                                                {
                                                    "type": "hide",
                                                    "target": [
                                                        "upiId"
                                                    ]
                                                },
                                                {
                                                    "type": "mandatory",
                                                    "target": [
                                                        "upiId"
                                                    ],
                                                    "value": false
                                                },
                                                {
                                                    "type": "setValue",
                                                    "target": [
                                                        "upiId"
                                                    ],
                                                    "value": ""
                                                }
                                            ]
                                        },
                                        {
                                            "condition": "value === 'upi'",
                                            "actions": [
                                                {
                                                    "type": "show",
                                                    "target": [
                                                        "upiId"
                                                    ]
                                                },
                                                {
                                                    "type": "mandatory",
                                                    "target": [
                                                        "upiId"
                                                    ],
                                                    "value": true
                                                },
                                                {
                                                    "type": "hide",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode"
                                                    ]
                                                },
                                                {
                                                    "type": "mandatory",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode"
                                                    ],
                                                    "value": false
                                                },
                                                {
                                                    "type": "setValue",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode"
                                                    ],
                                                    "value": ""
                                                }
                                            ]
                                        },
                                        {
                                            "condition": "value !== 'bank' && value !== 'upi'",
                                            "actions": [
                                                {
                                                    "type": "hide",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode",
                                                        "upiId"
                                                    ]
                                                },
                                                {
                                                    "type": "mandatory",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode",
                                                        "upiId"
                                                    ],
                                                    "value": false
                                                },
                                                {
                                                    "type": "setValue",
                                                    "target": [
                                                        "bankName",
                                                        "accountNumber",
                                                        "ifscCode",
                                                        "upiId"
                                                    ],
                                                    "value": ""
                                                }
                                            ]
                                        }
                                    ]
                                }
                            },
                            {
                                "name": "bankName",
                                "text": "Bank Name",
                                "description": "Enter the name of the bank",
                                "widget": "textField",
                                "oneLiner": true,
                                "hidden": true,
                                "mandatory": false
                            },
                            {
                                "name": "accountNumber",
                                "text": "Account Number",
                                "description": "Enter the bank account number",
                                "widget": "textField",
                                "oneLiner": true,
                                "hidden": true,
                                "mandatory": false
                            },
                            {
                                "name": "ifscCode",
                                "text": "IFSC Code",
                                "description": "Enter the bank's IFSC code",
                                "widget": "textField",
                                "oneLiner": true,
                                "hidden": true,
                                "mandatory": false
                            },
                            {
                                "name": "upiId",
                                "text": "UPI ID",
                                "description": "Enter UPI ID (e.g., username@bank)",
                                "widget": "textField",
                                "oneLiner": true,
                                "hidden": true,
                                "mandatory": false
                            }
                        ]
                    }
                ]
            }
        }
    },
    "active": true
}