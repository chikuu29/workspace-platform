{
  "id": "3",
  "pageName": "gymHomePage",
  "route": "gymHomePage",
  "appName": "myGym",
  "active": true,
  "appMeta": {
    "appName": "Gym",
    "viewName": "gymHomePage",
    "viewId": "3",
    "version": "2.0.0",
    "owner": "Suryanarayan Biswal",
    "createdAt": "2026-02-21"
  },
  "UI_TYPE": {
    "type": "GRID_VIEW",
    "title": "Gym Operations Dashboard",
    "description": "Operational command center for members, staff and performance.",
    "target": "grids",
    "layoutStyles": {
      "templateColumns": "repeat(2, minmax(0, 1fr))",
      "gap": "6"
    }
  },
  "UI_VIEW": {
    "schema": {
      "grids": [
        {
          "title": "Key Performance Indicators",
          "UI_TYPE": "KPI_SECTION",
          "KPIS": [
            {
              "label": "Revenue",
              "value": "$45,231.89",
              "helpText": "+20.1% from last month",
              "trend": "up",
              "widget": "KPI_CARD",
              "styles": {
                "backgroundColor": "#E6F7FF",
                "textColor": "#1890FF"
              },
              "colorPalette": "blue",
              "subKpis": [
                {
                  "label": "Membership",
                  "value": "$32,100"
                },
                {
                  "label": "PT Sessions",
                  "value": "$13,131"
                }
              ]
            },
            {
              "label": "Members",
              "value": "1,234",
              "helpText": "+12 new today",
              "trend": "up",
              "widget": "KPI_CARD",
              "styles": {
                "backgroundColor": "#E6F7FF",
                "textColor": "#1890FF"
              },
              "colorPalette": "green",
              "subKpis": [
                {
                  "label": "Active",
                  "value": "892"
                },
                {
                  "label": "Inactive",
                  "value": "342"
                }
              ]
            },
            {
              "label": "Trainers",
              "value": "48",
              "helpText": "8 currently in session",
              "trend": "neutral",
              "widget": "KPI_CARD",
              "styles": {
                "backgroundColor": "#FFF4E5",
                "textColor": "#FF7F50"
              },
              "colorPalette": "orange",
              "subKpis": [
                {
                  "label": "Visitors",
                  "value": "126"
                },
                {
                  "label": "Front Desk",
                  "value": "15"
                }
              ]
            }
          ]
        },
        {
          "id": "member-activity-table",
          "UI_TYPE": "TABLE_VIEW",
          "title": "Recent Member Activities",
          "TABLES": {
            "apis": {
              "loadData": {
                "path": "gym/members/activities",
                "method": "GET",
                "params": {
                  "tenantId": "{{tenantId}}",
                  "page": 1,
                  "pageSize": 50
                }
              }
            },
            "SETTINGS": {
              "columns": [
                {
                  "label": "ID",
                  "key": "id",
                  "width": "90px",
                  "textAlign": "center"
                },
                {
                  "label": "Member Name",
                  "key": "name",
                  "width": "220px",
                  "isSortable": true
                },
                {
                  "label": "Plan",
                  "key": "plan",
                  "width": "160px",
                  "isSortable": true,
                  "isSearchable": true
                },
                {
                  "label": "Assigned Trainer",
                  "key": "trainer",
                  "width": "180px",
                  "isSearchable": true
                },
                {
                  "label": "Status",
                  "key": "status",
                  "width": "120px",
                  "textAlign": "center",
                  "isSortable": true,
                  "isStatus": true,
                  "isSearchable": true
                },
                {
                  "label": "Last Visit",
                  "key": "lastVisit",
                  "width": "150px",
                  "isSortable": true
                }
              ],
              "filters": [
                {
                  "UI_TYPE": "FILTER_SECTION",
                  "key": "status",
                  "type": "select",
                  "label": "Status",
                  "options": [
                    {
                      "label": "All",
                      "value": "all"
                    },
                    {
                      "label": "Active",
                      "value": "Active"
                    },
                    {
                      "label": "Inactive",
                      "value": "Inactive"
                    }
                  ]
                },
                {
                  "UI_TYPE": "FILTER_SECTION",
                  "key": "plan",
                  "type": "select",
                  "label": "Plan",
                  "options": [
                    {
                      "label": "All",
                      "value": "all"
                    },
                    {
                      "label": "Annual Platinum",
                      "value": "Annual Platinum"
                    },
                    {
                      "label": "Monthly Basic",
                      "value": "Monthly Basic"
                    },
                    {
                      "label": "6-Month Flex",
                      "value": "6-Month Flex"
                    }
                  ]
                }
              ],
              "pagination": {
                "enabled": true,
                "pageSize": 10
              }
            },
            "events": {
              "EDIT_MEMBER": {
                "type": "NAVIGATE",
                "target": "EditMember",
                "params": {
                  "memberId": "{{selectedRow.id}}"
                }
              },
              "FREEZE_MEMBER": {
                "type": "API_CALL",
                "api": {
                  "path": "gym/members/freeze",
                  "method": "POST",
                  "body": {
                    "memberId": "{{selectedRow.id}}"
                  }
                },
                "onSuccess": {
                  "type": "REFRESH_DATA"
                }
              },
              "DELETE_MEMBER": {
                "type": "API_CALL",
                "api": {
                  "path": "gym/members/delete",
                  "method": "DELETE",
                  "body": {
                    "memberId": "{{selectedRow.id}}"
                  }
                },
                "onSuccess": {
                  "type": "REFRESH_DATA"
                }
              }
            }
          }
        }
      ]
    }
  }
}