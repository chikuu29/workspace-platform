  "UI_VIEW": {
    "schema": {
      "sections": [
      {
        "id": "kpi-summary",
        "UI_TYPE": "KPI_CARD",
        "title": "Gym Snapshot",
        "dataSource": "dashboardKpis",
        "props": {
          "columns": {
            "base": 1,
            "md": 2,
            "lg": 3,
            "xl": 3
          }
        }
      },
      {
        "id": "member-activity-table",
        "UI_TYPE": "TABLE_VIEW",
        "title": "Recent Member Activities",
        "dataSource": "memberActivityTable",
        "actionRef": "memberTableActions",
        "props": {
          "columns": [
            {
              "label": "ID",
              "key": "id",
              "width": "90px",
              "textAlign": "center"
            },
            {
              "label": "Member Name",
              "key": "name",
              "width": "220px",
              "isSortable": true
            },
            {
              "label": "Plan",
              "key": "plan",
              "width": "160px",
              "isSortable": true,
              "isSearchable": true
            },
            {
              "label": "Assigned Trainer",
              "key": "trainer",
              "width": "180px",
              "isSearchable": true
            },
            {
              "label": "Status",
              "key": "status",
              "width": "120px",
              "textAlign": "center",
              "isSortable": true,
              "isStatus": true,
              "isSearchable": true
            },
            {
              "label": "Last Visit",
              "key": "lastVisit",
              "width": "150px",
              "isSortable": true
            }
          ],
          "filters": [
            {
              "UI_TYPE": "FILTER_SECTION",
              "key": "status",
              "type": "select",
              "label": "Status",
              "options": [
                {
                  "label": "All",
                  "value": "all"
                },
                {
                  "label": "Active",
                  "value": "Active"
                },
                {
                  "label": "Inactive",
                  "value": "Inactive"
                }
              ]
            },
            {
              "UI_TYPE": "FILTER_SECTION",
              "key": "plan",
              "type": "select",
              "label": "Plan",
              "options": [
                {
                  "label": "All",
                  "value": "all"
                },
                {
                  "label": "Annual Platinum",
                  "value": "Annual Platinum"
                },
                {
                  "label": "Monthly Basic",
                  "value": "Monthly Basic"
                },
                {
                  "label": "6-Month Flex",
                  "value": "6-Month Flex"
                }
              ]
            }
          ],
          "pagination": {
            "enabled": true,
            "pageSize": 10
          }
        }
      },
      {
        "id": "analytics-overview",
        "UI_TYPE": "CHART_VIEW",
        "title": "Analytics",
        "dataSource": "revenueAnalytics",
        "props": {
          "components": [
            {
              "id": "revenue-line",
              "componentKey": "RevenuAnalytics",
              "title": "Revenue vs Members",
              "chartType": "line",
              "xKey": "month",
              "series": [
                {
                  "key": "revenue",
                  "label": "Revenue"
                },
                {
                  "key": "members",
                  "label": "Members"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "dashboard-actions",
        "UI_TYPE": "ACTION_BUTTON",
        "actionRef": "dashboardHeaderActions"
      }
      ]
