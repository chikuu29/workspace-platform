  "UI_TYPE": {
    "type": "FORM_VIEW",
    "title": "Add New Building Block / Property",
    "description": "Register a new building block or location sector to manage room allotments and billing scoping.",
    "target": "forms",
    "layoutStyles": {
      "p": "0"
    }
  },
  "UI_VIEW": {
    "schema": {
      "forms": {
        "tabs": [
          {
            "title": "Building Configuration",
            "description": "Primary settings of the physical building/property.",
            "iconName": "Building",
            "widgets": [
              {
                "name": "name",
                "text": "Building Name",
                "description": "Give a unique building identifier (e.g. Block A, Krishna Residency, North Wing)",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "location",
                "text": "Location / Campus / Sector",
                "description": "Specify location address or branch campus name (e.g. Main Campus, Sector-4)",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "description",
                "text": "Detailed Description / Amenities",
                "description": "Notes about facilities or types of rooms in this building",
                "widget": "textAreaField",
                "oneLiner": true
              }
            ]
          }
        ]
      }
    }
  }
