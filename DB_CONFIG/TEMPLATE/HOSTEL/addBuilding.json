  },
  "ACTIONS": {
    "showSaveButton": true,
    "events": {
      "submit": {
        "type": "API_CALL",
        "url": "hostel/addBuilding",
        "method": "POST",
        "successMessage": "Building added successfully!",
        "errorMessage": "Failed to add building. Please verify details.",
        "laterActions": {
          "type": "NAVIGATION",
          "path": "/app/myHostel/buildings"
        }
      }
    }
