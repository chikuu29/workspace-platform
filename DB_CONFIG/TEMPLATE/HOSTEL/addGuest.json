{
  "id": "hostel-add-guest",
  "pageName": "addGuest",
  "route": "addGuest",
  "appName": "myHostel",
  "active": true,
  "appMeta": {
    "appName": "Hostel",
    "viewName": "addGuest",
    "viewId": "hostel-add-guest",
    "version": "1.0.0",
    "owner": "Suryanarayan Biswal",
    "createdAt": "2026-05-20"
  },
  "ACTIONS": {
    "showSaveButton": true,
    "events": {
      "submit": {
        "type": "API_CALL",
        "url": "hostel/addGuest",
        "method": "POST",
        "successMessage": "Guest successfully registered and allocated to room!",
        "errorMessage": "Failed to onboard guest. Please check room availability and field inputs.",
        "laterActions": {
          "type": "NAVIGATION",
          "path": "/app/myHostel/guests"
        }
      }
    }
  },
  "UI_TYPE": {
    "type": "FORM_VIEW",
    "title": "Onboard New Guest",
    "description": "Premium guided wizard to collect guest contact profile, ID verification, room allotment and emergency references.",
    "target": "forms",
    "layoutStyles": {
      "p": "0"
    }
  },
  "UI_VIEW": {
    "schema": {
      "forms": {
        "tabs": [
          {
            "title": "Guest Profile",
            "description": "Standard identification and contact parameters.",
            "iconName": "UserPen",
            "widgets": [
              {
                "name": "firstName",
                "text": "First Name",
                "description": "Guest's given name",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "lastName",
                "text": "Last Name",
                "description": "Guest's family name",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "email",
                "text": "Email Address",
                "description": "For digital rent invoices, alerts, and receipt delivery",
                "widget": "textField",
                "type": "email",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "phone",
                "text": "Phone Number",
                "description": "Used for standard SMS notifications and checks",
                "widget": "textField",
                "type": "tel",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "nationalId",
                "text": "National Identity Number / Passport (KYC)",
                "description": "Enter SSN, Passport or Aadhaar number for KYC validation.",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              }
            ]
          },
          {
            "title": "Room Placement & Security",
            "description": "Allotment mapping and deposit records.",
            "iconName": "Bed",
            "widgets": [
              {
                "name": "buildingName",
                "text": "Select Building",
                "description": "Select the building block where the guest will reside.",
                "widget": "selectField",
                "mandatory": true,
                "oneLiner": true,
                "apiPath": "hostel/buildings/options",
                "labelField": "name",
                "valueField": "id",
                "events": {
                  "change": [
                    {
                      "actions": [
                        {
                          "type": "disabled",
                          "target": "room_number",
                          "value": false
                        },
                        {
                          "type": "setProp",
                          "target": "room_number",
                          "prop": "apiPath",
                          "value": "hostel/rooms/options?buildingName={{value}}"
                        },
                        {
                          "type": "setValue",
                          "target": "room_number",
                          "value": ""
                        },
                        {
                          "type": "setValue",
                          "target": "securityDeposit",
                          "value": ""
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "room_number",
                "text": "Select Room Number",
                "description": "Assign the specific available room unit in the selected building block.",
                "widget": "selectField",
                "mandatory": true,
                "oneLiner": true,
                "labelField": "name",
                "valueField": "id",
                "disabled": true,
                "events": {
                  "change": [
                    {
                      "actions": [
                        {
                          "type": "apiCall",
                          "apiPath": "hostel/rooms/security-deposit?buildingName={{buildingName}}&roomNumber={{value}}",
                          "method": "GET",
                          "next": [
                            {
                              "type": "setValue",
                              "target": "securityDeposit",
                              "value": "{{data.securityDeposit}}"
                            },
                            {
                              "type": "setProp",
                              "target": "securityDeposit",
                              "prop": "description",
                              "value": "{{data.securityDepositNote}}"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "allotmentDate",
                "text": "Allotment Check-in Date",
                "description": "Active onboarding date to start rent calculation.",
                "widget": "dateField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "securityDeposit",
                "text": "Security Deposit Collected (INR)",
                "description": "Standard refundable deposit amount paid by guest.",
                "widget": "textField",
                "type": "number",
                "oneLiner": true,
                "mandatory": true,
                "disabled": true
              }
            ]
          },
          {
            "title": "Emergency References",
            "description": "Primary fallback contact details in case of critical alerts.",
            "iconName": "PhoneCall",
            "widgets": [
              {
                "name": "emergencyName",
                "text": "Emergency Contact Name",
                "description": "Full name of parent, guardian or relative reference",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "emergencyRelation",
                "text": "Relationship to Guest",
                "description": "e.g. Father, Mother, Spouse, Friend",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "emergencyPhone",
                "text": "Emergency Phone Number",
                "description": "Contact number active 24/7",
                "widget": "textField",
                "type": "tel",
                "oneLiner": true,
                "mandatory": true
              }
            ]
          }
        ]
      }
    }
  }
}
