{
  "id": "hostel-add-tenant",
  "pageName": "addTenant",
  "route": "addTenant",
  "appName": "myHostel",
  "active": true,
  "appMeta": {
    "appName": "Hostel",
    "viewName": "addTenant",
    "viewId": "hostel-add-tenant",
    "version": "1.0.0",
    "owner": "Suryanarayan Biswal",
    "createdAt": "2026-05-20"
  },
  "ACTIONS": {
    "showSaveButton": true,
    "events": {
      "submit": {
        "type": "API_CALL",
        "url": "hostel/addTenant",
        "method": "POST",
        "successMessage": "Tenant successfully registered and allocated to room!",
        "errorMessage": "Failed to onboard tenant. Please check room availability and field inputs.",
        "laterActions": {
          "type": "NAVIGATION",
          "path": "/app/myHostel/tenants"
        }
      }
    }
  },
  "UI_TYPE": {
    "type": "FORM_VIEW",
    "title": "Onboard New Tenant",
    "description": "Premium guided wizard to collect resident contact profile, ID verification, room allotment and emergency references.",
    "target": "forms",
    "layoutStyles": {
      "p": "0"
    }
  },
  "UI_VIEW": {
    "schema": {
      "forms": {
        "tabs": [
          {
            "title": "Resident Profile",
            "description": "Standard identification and contact parameters.",
            "iconName": "UserPen",
            "widgets": [
              {
                "name": "firstName",
                "text": "First Name",
                "description": "Tenant's given name",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "lastName",
                "text": "Last Name",
                "description": "Tenant's family name",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "email",
                "text": "Email Address",
                "description": "For digital rent invoices, alerts, and receipt delivery",
                "widget": "textField",
                "type": "email",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "phone",
                "text": "Phone Number",
                "description": "Used for standard SMS notifications and checks",
                "widget": "textField",
                "type": "tel",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "nationalId",
                "text": "National Identity Number / Passport (KYC)",
                "description": "Enter SSN, Passport or Aadhaar number for KYC validation.",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              }
            ]
          },
          {
            "title": "Room Placement & Security",
            "description": "Allotment mapping and deposit records.",
            "iconName": "Bed",
            "widgets": [
              {
                "name": "room_number",
                "text": "Select Room Number",
                "description": "Input or assign the specific room unit (e.g. A-101). Note: The system will verify availability.",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "allotmentDate",
                "text": "Allotment Check-in Date",
                "description": "Active onboarding date to start rent calculation.",
                "widget": "dateField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "securityDeposit",
                "text": "Security Deposit Collected (INR)",
                "description": "Standard refundable deposit amount paid by tenant.",
                "widget": "textField",
                "type": "number",
                "oneLiner": true,
                "mandatory": true
              }
            ]
          },
          {
            "title": "Emergency References",
            "description": "Primary fallback contact details in case of critical alerts.",
            "iconName": "PhoneCall",
            "widgets": [
              {
                "name": "emergencyName",
                "text": "Emergency Contact Name",
                "description": "Full name of parent, guardian or relative reference",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "emergencyRelation",
                "text": "Relationship to Resident",
                "description": "e.g. Father, Mother, Spouse, Friend",
                "widget": "textField",
                "oneLiner": true,
                "mandatory": true
              },
              {
                "name": "emergencyPhone",
                "text": "Emergency Phone Number",
                "description": "Contact number active 24/7",
                "widget": "textField",
                "type": "tel",
                "oneLiner": true,
                "mandatory": true
              }
            ]
          }
        ]
      }
    }
  },
  "active": true
}
