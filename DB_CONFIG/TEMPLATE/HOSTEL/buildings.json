      "templateColumns": "1fr",
      "gap": "6"
    }
  },
  "UI_VIEW": {
    "schema": {
      "grids": [
        {
          "id": "hostel-buildings-table",
          "UI_TYPE": "TABLE_VIEW",
          "title": "Buildings Registry",
          "TABLES": {
            "APIS": {
              "loadData": {
                "path": "hostel/buildings",
                "method": "GET",
                "params": {
                  "tenantId": "{{tenantId}}"
                }
              }
            },
            "SETTINGS": {
              "columns": [
                {
                  "label": "Building Name",
                  "key": "data.name",
                  "width": "180px",
                  "isSortable": true,
                  "isSearchable": true
                },
                {
                  "label": "Location / Campus",
                  "key": "data.location",
                  "width": "220px",
                  "isSearchable": true
                },
                {
                  "label": "Description",
                  "key": "data.description",
                  "width": "300px"
                },
                {
                  "label": "Record ID",
                  "key": "_meta.record_id",
                  "width": "120px",
                  "textAlign": "center"
                }
              ],
              "pagination": {
                "enabled": true,
                "pageSize": 10
              }
            }
          }
        }
      ]
