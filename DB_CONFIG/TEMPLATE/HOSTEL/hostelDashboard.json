{
  "id": "hostel-home",
  "pageName": "home",
  "route": "home",
  "appName": "myHostel",
  "active": true,
  "appMeta": {
    "appName": "Hostel",
    "viewName": "home",
    "viewId": "hostel-home",
    "version": "1.0.0",
    "owner": "Suryanarayan Biswal",
    "createdAt": "2026-05-20"
  },
  "UI_TYPE": {
    "type": "CONTAINER_VIEW",
    "title": "Hostel Operations Command Center",
    "description": "Premium multi-tenant real-time metrics, room allocations, occupancy tracking and dues analytics.",
    "target": "UI_VIEW.schema.components",
    "layoutStyles": {
      "p": {
        "base":1,
        "md": 4
      }
    }
  },
  "UI_VIEW": {
    "schema": {
      "components": [
        {
          "title": "Key Operational Metrics",
          "UI_TYPE": "KPI_SECTION",
          "icon": "Activity",
          "layout": {
            "columns": {
              "base": 2,
              "sm": 2,
              "md": 3,
              "lg": 4,
              "xl": 5
            },
            "gap": 4
          },
          "APIS": {
            "path": "hostel/analytics/kpis",
            "method": "GET",
            "key": "loadData"
          },
          "KPIS": [
            {
              "label": "Beds Occupancy Rate",
              "value": "{{occupancy_rate}}",
              "helpText": "{{occupied_beds}} / {{total_beds}} beds allocated",
              "trend": "up",
              "widget": "KPI_CARD",
              "icon": "Bed",
              "colorPalette": "cyan",
              "subKpis": [
                {
                  "label": "Occupied Beds",
                  "value": "{{occupied_beds}}"
                },
                {
                  "label": "Total Beds",
                  "value": "{{total_beds}}"
                }
              ]
            },
            {
              "label": "Active Boarded Tenants",
              "value": "{{active_tenants}}",
              "helpText": "All active student/professional allocations",
              "trend": "neutral",
              "widget": "KPI_CARD",
              "icon": "Users",
              "colorPalette": "green",
              "subKpis": [
                {
                  "label": "In-Residence",
                  "value": "{{active_tenants}}"
                }
              ]
            },
            {
              "label": "Outstanding Dues",
              "value": "₹{{total_dues}}",
              "helpText": "Total pending rent and utilities bills",
              "trend": "down",
              "widget": "KPI_CARD",
              "icon": "IndianRupee",
              "colorPalette": "purple",
              "subKpis": [
                {
                  "label": "Pending Payments",
                  "value": "₹{{total_dues}}"
                }
              ]
            },
            {
              "label": "Active Maintenance Tickets",
              "value": "{{open_complaints}}",
              "helpText": "Tickets pending resolution",
              "trend": "neutral",
              "widget": "KPI_CARD",
              "icon": "Wrench",
              "colorPalette": "red",
              "subKpis": [
                {
                  "label": "Open Requests",
                  "value": "{{open_complaints}}"
                }
              ]
            },
            {
              "label": "Managed Buildings",
              "value": "{{total_buildings}}",
              "helpText": "Active hostel buildings and blocks",
              "trend": "up",
              "widget": "KPI_CARD",
              "icon": "Building",
              "colorPalette": "orange",
              "subKpis": [
                {
                  "label": "Blocks",
                  "value": "{{total_buildings}}"
                }
              ]
            }
          ]
        },
        {
          "id": "recent-tenants-table",
          "UI_TYPE": "TABLE_VIEW",
          "title": "Recently Onboarded Tenants",
          "layout": {
            "gridColumn": "1 / -1"
          },
          "TABLES": {
            "apis": {
              "loadData": {
                "path": "hostel/tenants",
                "method": "GET",
                "params": {
                  "skip": 0,
                  "limit": 5
                }
              }
            },
            "SETTINGS": {
              "columns": [
                {
                  "label": "ID",
                  "key": "data.tenant_id",
                  "width": "90px",
                  "textAlign": "center"
                },
                {
                  "label": "Tenant Name",
                  "key": "data.firstName",
                  "width": "200px"
                },
                {
                  "label": "Allocated Room",
                  "key": "data.room_number",
                  "width": "120px"
                },
                {
                  "label": "Contact Phone",
                  "key": "data.phone",
                  "width": "160px"
                },
                {
                  "label": "Rent Status",
                  "key": "data.rent_status",
                  "width": "120px",
                  "textAlign": "center",
                  "isStatus": true
                }
              ],
              "pagination": {
                "enabled": false,
                "pageSize": 5
              }
            }
          }
        }
      ]
    }
  }
}